# Copy to .env and fill in. Do not commit .env.
# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=8000
# Default: <project root>/data, independent of the server working directory.
# APP_DATA_DIR=D:/absolute/path/to/data

# Database (SQLite). Docker/direct run share the same folder.
# Default: <APP_DATA_DIR>/hackathon.db. Override only with an absolute database path.
# DATABASE_URL=sqlite:///D:/absolute/path/to/data/hackathon.db

# Admin bootstrap (used only when the first admin is created on init)
APP_FIRST_ADMIN_LOGIN=admin
APP_FIRST_ADMIN_PASSWORD=change-me
APP_FIRST_ADMIN_NAME=Administrator

# External integrations (phase 6+; mocks until keys are provided)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_GEMINI_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_PRIORITY_PROVIDER=gemini
GOOGLE_DRIVE_FOLDER_ID=
FXTUNNEL_TOKEN=
